# ==============================================================================
# Engineering Club Website — Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Project Credentials (Required)
# Find in: Supabase Dashboard > Project Settings > API
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key

# Server-only Service Role Secret (Keep private, never expose to client)
# Find in: Supabase Dashboard > Project Settings > API > service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Direct PostgreSQL Connection String (Optional, for direct migration scripts)
# Find in: Supabase Dashboard > Project Settings > Database > Connection String > URI
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-id.supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# 2. Application Configuration
# ------------------------------------------------------------------------------
# Base site URL for email redirects, auth callbacks, and link generation
# Development: http://localhost:3000
# Production: https://your-domain.vercel.app or https://club.university.edu
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Allowed school email domain for student registrations (e.g. university.edu)
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAIN=university.edu
